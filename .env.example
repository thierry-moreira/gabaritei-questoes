# ==============================================================================
# GABARITEI QUESTÕES (APP DO ALUNO) - CONFIGURAÇÕES DE AMBIENTE (.env)
# ==============================================================================
# Este app NÃO usa a chave service_role em NENHUM lugar — apenas a chave ANON,
# protegida pelas policies RLS do Supabase (leitura de dados de estudo liberada;
# escrita exige o header x-app-token — detalhes em docs/banco_dados.md).

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR FLASK
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=true

# Chave secreta de sessão e proteção CSRF (gerar com: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=sua_chave_secreta_flask_aqui

# Quantidade de proxies reversos confiáveis (0 para localhost direto)
TRUSTED_PROXIES=0

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS - SUPABASE
# ------------------------------------------------------------------------------
# URL do seu projeto no Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave ANON do Supabase — pública por design (vai no bundle Electron) e
# protegida pelas policies RLS. Não dá acesso a admins/logs_admin nem escrita
# em questões/taxonomia.
SUPABASE_ANON_KEY=sua_chave_anon_do_supabase

# Token de APP do aluno (gerar com: python -c "import secrets; print(secrets.token_hex(32))")
# injetado no header x-app-token de todas as requisições. As policies de ESCRITA
# exigem esse header (RLS valida via public.eh_app_aluno). Deve ser o MESMO valor
# de desktop/token.local.js (shell Electron) e da função do banco.
APP_TOKEN=seu_token_de_app_aleatorio

# ------------------------------------------------------------------------------
# 3. INTELIGÊNCIA ARTIFICIAL - OPENAI (Explicações de questões e flashcards)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-sua-chave-openai-aqui